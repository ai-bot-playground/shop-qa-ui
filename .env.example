# Szablon konfiguracji lokalnej. Skopiuj do `.env` i uzupełnij klucz API.
#
#   cp .env.example .env
#
# UWAGA: pusty klucz API NIE włącza żadnego trybu demo — każde wywołanie idzie
# do OpenRoutera i bez klucza kończy się błędem 401. Do przeklikania całego
# workflow bez modelu i bez kosztów służy jawny tryb offline (QA_FAKE_LLM, niżej).

# ─────────────────────────────────────────────────────────────
# OpenRouter (OpenAI-compatible) — jedyna aktywna ścieżka LLM
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_TOKENS=32000

# ─────────────────────────────────────────────────────────────
# Tryb offline (atrapa LLM — src/fake_llm.py)
# ─────────────────────────────────────────────────────────────
# QA_FAKE_LLM=1 → deterministyczne odpowiedzi atrapy, zero wywołań sieciowych,
# zero kosztów. Cały przepływ (analiza → plan → generacja → walidacja → PR)
# działa normalnie, tylko treści pochodzą z atrapy, nie z modelu.
# Wygodniej: `powershell -File run-local.ps1 -Fake`.
# QA_FAKE_LLM=

# ─────────────────────────────────────────────────────────────
# Pozostałe (opcjonalne)
# ─────────────────────────────────────────────────────────────
# Katalog z lokalnymi klonami repo shop-*. Domyślnie katalog nadrzędny
# shop-qa-ui — ustawiany automatycznie przez run-local.ps1.
# SHOP_REPOS_DIR=
#
# Telemetria tokenów (shop-token-metrics). Pusty = wyłączona.
# Natywnie: http://localhost:8088 (port-forward-ui.ps1).
# TOKEN_METRICS_URL=http://localhost:8088
