# Szablon konfiguracji dla wariantu kontenerowego (compose.yaml → env_file).
#
#   cp .env.docker.example .env.docker      # następnie uzupełnij OPENROUTER_API_KEY
#
# Różnica względem .env: wartości są widziane Z WNĘTRZA kontenera, więc adresy
# innych serwisów to nazwy z sieci compose, nie `localhost`.
#
# UWAGA: kontenerowy shop-qa-ui obsługuje wyłącznie indeksowanie i analizę.
# Nie ma w obrazie JDK, Node, `gh` ani klonów repo shop-*, a ConfigMap/compose
# nie ustawiają SHOP_REPOS_DIR — lokalna walidacja i wystawianie PR-ów działają
# tylko w wariancie natywnym (run-local.ps1).

# ─────────────────────────────────────────────────────────────
# OpenRouter (OpenAI-compatible) — jedyna aktywna ścieżka LLM
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_MAX_TOKENS=32000

# Tryb offline (atrapa LLM) — do demonstracji UI bez klucza i bez kosztów.
# QA_FAKE_LLM=1

# Telemetria tokenów → shop-token-metrics po nazwie serwisu w sieci compose.
TOKEN_METRICS_URL=http://shop-token-metrics:8080
